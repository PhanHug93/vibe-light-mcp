# ============================================================================
# Environment Variables — TechStack Local MCP Server (Production)
# ============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env
#
# Target: Ubuntu Server (Intel i5, 8GB RAM)
# ============================================================================

# --- MCP Server ---
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_EXEC_MODE=allowlist

# --- Ports (host mapping) ---
# Chỉ MCP Server được expose. MemoryDB là internal-only.
MCP_EXTERNAL_PORT=8000

# --- MemoryDB (ChromaDB backend, internal, không cần thay đổi) ---
# MCP_CHROMA_HOST và MCP_CHROMA_PORT được hardcode trong docker-compose.yml
# vì MemoryDB chỉ giao tiếp nội bộ qua Docker network.

# --- Docker storage paths inside mcp_server ---
# Các path này được map vào Docker named volumes trong docker-compose.yml.
MCP_CHROMA_DB=/data/db
MCP_USAGE_LOG_DIR=/data/usage_logs
MCP_TECH_STACKS_DIR=/app/tech_stacks
MCP_SKILL_REGISTRY_DIR=/app/skill_registry
MCP_SKILL_STORE_PATH=/app/skill_registry/index/skill_store.sqlite
